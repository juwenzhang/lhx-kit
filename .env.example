# ═══════════════════════════════════════════════════════════
# lhx-kit 环境变量示例
# ═══════════════════════════════════════════════════════════
# 拷贝到 .env 或 .env.local 后填入真实值。
# .env / .env.*.local 已在 .gitignore 里，不会进 git。
# ═══════════════════════════════════════════════════════════

# 指定 Vite 命令类型（由 CLI 自动注入，正常无需手动设置）
# LHX_VITE_COMMAND=dev | build | preview

# 指定 env 模式（会被 resolveEnv 按 ['prod','staging','test','dev'] 降级）
# LHX_MODE=dev

# API 基础 URL（当 project.config.ts 里的 env 没填时用作 fallback）
# LHX_API_BASE=https://api.example.com

# Debug 开关（规划中，当前无效）
# DEBUG=lhx:*

# npm 发布需要的 token（仅维护者用）
# NPM_TOKEN=

# GitHub Actions 用的 PAT（仅 release workflow）
# GH_TOKEN=
