# pnpm 行为 ────────────────────────────────────────────────

# workspace 内部依赖必须显式用 workspace:* 或 workspace:^ 协议声明；
# 禁止 npm 社区 registry 查出同名包时静默回落（避免供应链劫持）。
link-workspace-packages=true
prefer-workspace-packages=true

# 严格 peer 依赖。缺少 peer 时报错而不是装成虚拟幽灵。
strict-peer-dependencies=false
auto-install-peers=true

# pnpm 10+：把 .pnpm 虚拟存储里的包以硬链接拷到 node_modules，保证不小心
# require('some-transitive-dep') 会失败（避免隐式依赖陷阱）。
hoist=true
shamefully-hoist=false

# 性能 ────────────────────────────────────────────────────

# 并发网络/IO 上限。CI 容器 vCPU 普遍 2~4 核，这个值能充分利用带宽
# 又不至于把 memory cgroups 打爆。
network-concurrency=16
child-concurrency=5

# 共享 store：同机器上多个 pnpm 项目复用 content-addressable store。
# Docker 构建时可挂载这个目录加速。
store-dir=~/.pnpm-store

# 国内镜像加速（如需可以取消注释）────────────────────────
# registry=https://registry.npmmirror.com/

# 行为约束 ─────────────────────────────────────────────────

# 不允许无 lockfile 的安装。保护 CI 和生产环境。
frozen-lockfile=false

# 所有 script 默认把 cwd 下的 node_modules/.bin 加到 PATH。
# 这是 npm 的默认行为，pnpm 要显式开启。
shell-emulator=true

# 版本标签提示 ────────────────────────────────────────────
save-prefix=^
