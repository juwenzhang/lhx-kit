{
  "name": "@lhx-kit/config",
  "version": "0.0.2",
  "description": "Project and offline config schema, loader, and helpers for lhx-kit. SSOT for the whole toolchain.",
  "keywords": ["lhx-kit", "config", "schema", "zod", "jiti", "monorepo"],
  "license": "MIT",
  "author": "luhanxin",
  "repository": {
    "type": "git",
    "url": "https://github.com/juwenzhang/lhx-kit.git",
    "directory": "packages/config"
  },
  "homepage": "https://juwenzhang.github.io/lhx-kit/",
  "bugs": {
    "url": "https://github.com/juwenzhang/lhx-kit/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "README.zh-CN.md", "LICENSE", "CHANGELOG.md", "package.json", "tsconfig.json"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "jiti": "^2.4.2",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@lhx-kit/tsconfig": "workspace:*",
    "@types/node": "^25.6.0",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
