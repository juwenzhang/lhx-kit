{
  "name": "@lhx-kit/tsconfig",
  "version": "1.0.1",
  "description": "Shared TypeScript configuration presets for the lhx-kit monorepo (base/library/react/vue/node). Designed so packages can `extends` via Node resolution — works identically before AND after npm publish.",
  "keywords": [
    "lhx-kit",
    "tsconfig",
    "typescript",
    "shared-config"
  ],
  "exports": {
    "./base.json": "./base.json",
    "./library.json": "./library.json",
    "./react.json": "./react.json",
    "./vue.json": "./vue.json",
    "./node.json": "./node.json",
    "./app-react.json": "./app-react.json",
    "./app-vue.json": "./app-vue.json"
  },
  "license": "MIT",
  "author": "luhanxin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juwenzhang/lhx-kit.git",
    "directory": "packages/tsconfig"
  },
  "homepage": "https://juwenzhang.github.io/lhx-kit/",
  "bugs": {
    "url": "https://github.com/juwenzhang/lhx-kit/issues"
  },
  "files": [
    "base.json",
    "library.json",
    "react.json",
    "vue.json",
    "node.json",
    "app-react.json",
    "app-vue.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md",
    "package.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
