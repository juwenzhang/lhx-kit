{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@lhx-kit/tsconfig/app-react",
  "extends": "./base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@pages/*": ["src/pages/*"],
      "@components/*": ["src/components/*"]
    }
  }
}
