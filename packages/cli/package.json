{
  "name": "@lhx-kit/cli",
  "version": "0.0.3",
  "description": "lhx-kit CLI: scaffold real-world MPA projects with create / add / dev / build / info / doctor / offline / upgrade commands.",
  "keywords": [
    "lhx-kit",
    "cli",
    "scaffold",
    "generator",
    "monorepo",
    "mpa",
    "vite"
  ],
  "license": "MIT",
  "author": "luhanxin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juwenzhang/lhx-kit.git",
    "directory": "packages/cli"
  },
  "homepage": "https://juwenzhang.github.io/lhx-kit/cli/reference",
  "bugs": {
    "url": "https://github.com/juwenzhang/lhx-kit/issues"
  },
  "type": "module",
  "bin": {
    "lhx-cli": "./dist/bin.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md",
    "package.json",
    "tsconfig.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@lhx-kit/config": "workspace:*",
    "@lhx-kit/offline": "workspace:*",
    "cac": "^7.0.0",
    "execa": "^9.6.0",
    "fs-extra": "^11.2.0",
    "giget": "^3.2.0",
    "jiti": "^2.4.2",
    "kolorist": "^1.8.0",
    "prompts": "^2.4.2",
    "ts-morph": "^28.0.0"
  },
  "peerDependencies": {
    "@lhx-kit/skills": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@lhx-kit/skills": {
      "optional": true
    }
  },
  "devDependencies": {
    "@lhx-kit/skills": "workspace:*",
    "@lhx-kit/tsconfig": "workspace:*",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.6.0",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
