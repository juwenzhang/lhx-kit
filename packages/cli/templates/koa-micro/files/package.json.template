{
  "name": "<%= packageName %>",
  "version": "0.0.0",
  "private": true,
  "description": "<%= appTitle %> — Koa microservice",
  "type": "module",
  "main": "./dist/server.js",
  "packageManager": "pnpm@10.0.0",
  "engines": {"node": ">=20.0.0"},
  "scripts": {
    "dev": "nodemon",
    "dev:worker": "nodemon --config nodemon.worker.json",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@koa/router": "^15.5.0",
    "bullmq": "^5.0.0",
    "ioredis": "^5.4.0",
    "koa": "^3.2.0",
    "koa-bodyparser": "^4.4.1",
    "koa-compress": "^5.2.1",
    "koa-helmet": "^9.0.0",
    "pino": "^9.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@types/koa": "^3.0.0",
    "@types/koa__cors": "^3.3.0",
    "@types/koa__router": "^12.0.5",
    "@types/koa-bodyparser": "^4.3.12",
    "@types/koa-compress": "^4.0.7",
    "@types/node": "^20.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "pino-pretty": "^13.0.0",
    "nodemon": "^3.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0"
  }
}
