{
  "name": "<%= packageName %>-mono",
  "version": "0.0.0",
  "private": true,
  "description": "<%= appTitle %> — business full-stack monorepo",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {"node": ">=20.0.0", "pnpm": ">=9.0.0"},
  "scripts": {
    "build": "pnpm -r --filter='./apps/*' --filter='./packages/*' build",
    "dev": "pnpm -r --parallel --filter='./apps/*' --filter='./packages/*' dev",
    "typecheck": "pnpm -r --filter='./apps/*' --filter='./packages/*' typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "typescript": "^5.4.0"
  }
}
