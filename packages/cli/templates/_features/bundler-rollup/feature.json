{
  "name": "bundler-rollup",
  "title": "Bundler: rollup",
  "description": "Rollup-based build. Maximum control over output formats; idiomatic for CDN-distributed libraries.",
  "appliesTo": ["lib-single", "lib-monorepo"],
  "mutexGroup": "bundler",
  "isDefault": false,
  "priority": 700,
  "files": ["files"],
  "packageOverlay": {
    "scripts": {
      "dev": "rollup --config --watch",
      "build": "rollup --config"
    }
  },
  "workspaceOverlay": {
    "devDependencies": {
      "rollup": "^4.30.0",
      "@rollup/plugin-commonjs": "^28.0.0",
      "@rollup/plugin-node-resolve": "^16.0.0",
      "@rollup/plugin-typescript": "^12.1.0",
      "rollup-plugin-dts": "^6.1.0",
      "tslib": "^2.8.0"
    }
  },
  "monorepoExpand": {
    "lib-monorepo": "packages/*"
  }
}
