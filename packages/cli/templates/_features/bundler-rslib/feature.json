{
  "name": "bundler-rslib",
  "title": "Bundler: rslib",
  "description": "rslib (Rspack-based) build. Faster than rollup for medium libs, native UMD support.",
  "appliesTo": ["lib-single", "lib-monorepo"],
  "mutexGroup": "bundler",
  "isDefault": false,
  "priority": 700,
  "files": ["files"],
  "packageOverlay": {
    "scripts": {
      "dev": "rslib build --watch",
      "build": "rslib build"
    }
  },
  "workspaceOverlay": {
    "devDependencies": {
      "@rslib/core": "^0.5.0"
    }
  },
  "monorepoExpand": {
    "lib-monorepo": "packages/*"
  }
}
