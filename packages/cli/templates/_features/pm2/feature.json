{
  "name": "pm2",
  "title": "Process manager: PM2 + cluster",
  "description": "Adds an ecosystem.config.cjs for PM2 process management with cluster mode (all CPU cores). Scripts: start:pm2, stop:pm2, reload:pm2, logs:pm2.",
  "appliesTo": [
    "express-service", "koa-service", "fastify-service",
    "express-micro", "koa-micro", "fastify-micro",
    "node-ts"
  ],
  "mutexGroup": null,
  "isDefault": false,
  "priority": 900,
  "files": ["files"],
  "packageOverlay": {
    "scripts": {
      "start:pm2": "pm2 start ecosystem.config.cjs",
      "stop:pm2": "pm2 stop ecosystem.config.cjs",
      "reload:pm2": "pm2 reload ecosystem.config.cjs",
      "logs:pm2": "pm2 logs"
    },
    "devDependencies": {
      "pm2": "^5.4.0"
    }
  }
}
