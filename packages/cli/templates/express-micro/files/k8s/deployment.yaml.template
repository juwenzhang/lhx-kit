apiVersion: apps/v1
kind: Deployment
metadata:
  name: <%= packageName %>
  labels:
    app: <%= packageName %>
spec:
  replicas: 1
  selector:
    matchLabels:
      app: <%= packageName %>
  template:
    metadata:
      labels:
        app: <%= packageName %>
    spec:
      containers:
        - name: <%= packageName %>
          image: <%= packageName %>:latest
          ports:
            - containerPort: 3000
          env:
            - name: NODE_ENV
              value: production
            - name: PORT
              value: "3000"
          livenessProbe:
            httpGet:
              path: /livez
              port: 3000
            initialDelaySeconds: 5
            periodSeconds: 10
          readinessProbe:
            httpGet:
              path: /readyz
              port: 3000
            initialDelaySeconds: 5
            periodSeconds: 5
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              cpu: 500m
              memory: 512Mi
