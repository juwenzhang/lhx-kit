{
  "name": "vmpa",
  "version": "0.0.1",
  "private": true,
  "description": "VMPA Demo - multi-page Vue 3 application powered by lhx-kit.",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "lhx-cli dev",
    "build": "lhx-cli build",
    "preview": "lhx-cli preview",
    "info": "lhx-cli info",
    "doctor": "lhx-cli doctor",
    "add": "lhx-cli add",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "prepare": "husky",
    "offline:build": "lhx-cli offline build --hybrid-type=prod",
    "offline:inspect": "lhx-cli offline inspect dist-offline"
  },
  "dependencies": {
    "@lhx-kit/renderer": "workspace:*",
    "@lhx-kit/runtime": "workspace:*",
    "pinia": "^4.1.0",
    "tdesign-mobile-vue": "^1.17.1",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@lhx-kit/cli": "workspace:^",
    "@lhx-kit/config": "workspace:*",
    "@lhx-kit/tsconfig": "workspace:*",
    "@lhx-kit/vite-plugin": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/ui": "^5.0.5",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "msw": "^3.0.3",
    "postcss-pxtorem": "^6.1.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14"
  }
}
