{
  "name": "express-micro-smoke",
  "version": "0.0.0",
  "private": true,
  "description": "express-micro-smoke \u2014 Express microservice",
  "type": "module",
  "main": "./dist/server.js",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "nodemon",
    "dev:worker": "nodemon --config nodemon.worker.json",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "bullmq": "^5.76.10",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.4.3",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^25.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.22.1",
    "typescript": "^6.0.3",
    "@types/pg": "^8.11.0",
    "nodemon": "^3.1.0"
  }
}
