{
  "name": "koa-svc-smoke",
  "version": "0.0.0",
  "private": true,
  "description": "koa-svc-smoke \u2014 Koa service",
  "type": "module",
  "main": "./dist/server.js",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "nodemon",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@koa/router": "^15.5.0",
    "ioredis": "^5.4.0",
    "koa": "^3.2.1",
    "koa-bodyparser": "^4.4.1",
    "koa-compress": "^5.2.1",
    "koa-helmet": "^9.0.0",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@types/koa": "^3.0.3",
    "@types/koa-bodyparser": "^4.3.12",
    "@types/koa-compress": "^4.0.6",
    "@types/koa__cors": "^5.0.1",
    "@types/koa__router": "^12.0.4",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "nodemon": "^3.1.0"
  }
}
