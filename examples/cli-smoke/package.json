{
  "name": "examples-cli-smoke",
  "version": "0.0.1",
  "private": true,
  "description": "examples/cli-smoke - multi-page Vue 3 application powered by lhx-kit.",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "lhx-cli dev",
    "build": "lhx-cli build",
    "preview": "lhx-cli preview",
    "info": "lhx-cli info",
    "doctor": "lhx-cli doctor",
    "add": "lhx-cli add",
    "typecheck": "vue-tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "prepare": "husky",
    "offline:build": "lhx-cli offline build --hybrid-type=prod",
    "offline:inspect": "lhx-cli offline inspect dist-offline"
  },
  "dependencies": {
    "@lhx-kit/renderer": "workspace:*",
    "@lhx-kit/runtime": "workspace:*",
    "pinia": "^4.0.3",
    "tdesign-mobile-vue": "^1.16.1",
    "vue": "^3.5.42",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@lhx-kit/config": "workspace:*",
    "@lhx-kit/tsconfig": "workspace:*",
    "@lhx-kit/vite-plugin": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^26.4.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/ui": "^4.1.11",
    "@vue/test-utils": "^2.5.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.4.1",
    "msw": "^2.15.0",
    "typescript": "^7.0.2",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11",
    "postcss-pxtorem": "^6.1.0",
    "less": "^4.9.0",
    "unocss": "^66.8.1",
    "@unocss/preset-uno": "^66.8.1",
    "@unocss/preset-attributify": "^66.8.1",
    "@unocss/preset-icons": "^66.8.1"
  }
}
