{
  "name": "express-svc-smoke",
  "version": "0.0.0",
  "private": true,
  "description": "express-svc-smoke \u2014 Express service",
  "type": "module",
  "main": "./dist/server.js",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "nodemon",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.0",
    "pg": "^8.13.0",
    "ioredis": "^5.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "@types/pg": "^8.11.0",
    "nodemon": "^3.1.0"
  }
}
